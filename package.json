{
  "name": "mynotion",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "start": "node --disable-warning=ExperimentalWarning apps/server/src/index.ts",
    "serve": "pnpm build && pnpm start",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.mjs",
    "share": "node --disable-warning=ExperimentalWarning scripts/share.mjs",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "6.0.3"
  }
}
